# Local dev: point at your Laravel backend running on `php artisan serve`
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Once the backend is deployed to the subdomain (Section 7 of the handoff):
# NEXT_PUBLIC_API_URL=https://api.digiftedhub.com/api

# Cloudinary — used for staff media uploads on /staff/dashboard
# Create an "Unsigned" upload preset in Cloudinary > Settings > Upload
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
